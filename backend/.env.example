# доп. настройки (можно оставить неизменными)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres

MINIO_HOST=minio
MINIO_PORT=9000

KC_HOST=keycloak:8080
KC_USES_AUTH_ENDPOINT=false

# если HTTPS то prod ставим
ENV=dev

# логин и пароль для Postgres (передается из корневого .env, но можно переписать)
# DB_USER=
# DB_PASSWORD=

# логин и пароль для Minio (передается из корневого .env, но можно переписать)
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=

# вместо LOGIN, PASSWORD и PORT указать соответствующие логин, пароль и порт (не панели) для RabbitMQ
CELERY_BROKER_URL=amqp://LOGIN:PASSWORD@rabbitmq:PORT/%2Fcelery

# секреты для JWT авторизации
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# настройки keycloak
KC_REALM=
KC_ALLOWED_ROLES=["employee"]

# настройки CORS (надо прокинуть адрес фронтенда, не локалхост)
CORS_ALLOWED_ORIGINS=["http://127.0.0.1:4200", "http://localhost:4200"]